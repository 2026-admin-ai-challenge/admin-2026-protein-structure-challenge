# LOCAL DEVELOPMENT ONLY. Generate new secrets before deployment.
POSTGRES_PASSWORD=local-challenge-only
SECRET_KEY=local-development-only-change-this-64-character-secret-before-deploy
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATA_HOST_DIR=../admin-2026-protein-data/data

# Submission limits. Confirmed: ZIP 500 MB, inference 10 minutes, 20 submissions per team.
MAX_ZIP_BYTES=524288000
INFERENCE_TIMEOUT_SECONDS=600
TEAM_SUBMISSION_LIMIT=20
# Keep the team's highest Public score ZIP; retain records and scores for all submissions.
# keep_all disables automatic ZIP cleanup.
ZIP_RETENTION=best_public
# PROVISIONAL until organizers decide (Q2, Q3).
MAX_UNZIPPED_BYTES=2147483648
MAX_ZIP_ENTRIES=2000
ZIP_REQUIRED=inference.py,train.py,requirements.txt,model/

# Until this time (ISO 8601) only signed-in admins see the site; everyone else gets a
# D-day countdown that hides the topic. Unset means 2026-11-01 13:00 KST. A past time
# opens the site now. APPLY_URL is the sign-up Google Form behind the countdown's button.
# web and api both read LAUNCH_AT: after changing it run `docker compose up -d web api`.
# LAUNCH_AT=2026-11-01T13:00:00+09:00
# APPLY_URL=https://forms.gle/...

# Mock evaluator only: seconds a fake scoring run takes.
MOCK_DELAY_SECONDS=5

# Real scoring (docker-compose.evaluator.yml). Host paths on the scoring computer.
# The input directory holds only test.csv, test_features.csv, test_structures.zip (no labels).
# On Docker Desktop for Windows use an ASCII path such as C:/admin-eval/input.
# EVAL_WORK_HOST_DIR=/srv/admin-eval-work
# EVAL_INPUT_HOST_DIR=/srv/admin-eval-input
# EVAL_COMMAND=python inference.py --input /input/test_features.csv --output /output/predictions.csv
# EVAL_IMAGE=admin-evaluator:latest
# EVAL_CPUS=4
# EVAL_MEMORY=8g
# Seconds to install a submission's requirements.txt packages, not counted in inference.
# EVAL_INSTALL_TIMEOUT_SECONDS=600
# Volume caching packages downloaded from PyPI between submissions. Empty: no cache.
# EVAL_PIP_CACHE_VOLUME=admin-eval-pip-cache

# Real scoring on a GPU machine over SSH (docker-compose.remote.yml). The worker checks the
# machine first and cancels the connection, saying why on the admin page, if anything is
# missing. See docs/deployment.md.
#   sandbox (default): no Docker there. Needs bwrap, unprivileged user namespaces and a
#     scoring environment made by apps/evaluator/setup-server.sh.
#   remote: needs Docker usable by the account, the NVIDIA Container Toolkit and the image.
# EVAL_REMOTE_EVALUATOR=sandbox      # or remote
# EVAL_SSH_HOST=100.64.0.10          # IP address or host name; with Tailscale, its 100.x address
# EVAL_SSH_PORT=22
# EVAL_SSH_USER=evaluator            # a dedicated account (for remote: one that may use Docker)
# EVAL_SSH_ALLOWED=100.64.0.0/10     # optional: only IP addresses inside these networks are accepted
# EVAL_GPUS=0                        # GPU index on that machine, "0,1", or "all"; sandbox: empty = CPU only
# EVAL_REMOTE_WORK_DIR=/home/evaluator/admin-eval/work     # paths ON the GPU machine
# EVAL_REMOTE_INPUT_DIR=/home/evaluator/admin-eval/input   # only test.csv, test_features.csv, test_structures.zip
# EVAL_SANDBOX_ROOT=/home/evaluator/admin-eval             # sandbox: the --root given to setup-server.sh
# EVAL_SANDBOX_LIMITS=cgroup         # sandbox: memory/CPU/process limits via systemd-run --user; none = time and output limits only
# EVAL_SANDBOX_RUN_UID=64000         # sandbox with isolation off on the admin page, SSH account root: the uid steps run as
# EVAL_IMAGE=ghcr.io/2026-admin-ai-challenge/admin-2026-protein-structure-challenge/evaluator:<commit>  # remote: pin; pulled on the GPU machine
# EVAL_SSH_KEY_FILE=./secrets/eval_ssh_key              # chown 10001 and chmod 600
# EVAL_SSH_KNOWN_HOSTS_FILE=./secrets/eval_known_hosts  # the machine's host key, checked on every connection
# EVAL_MIN_FREE_GB=10

# Bytes the inference output directory may hold. Empty: the prediction contract's
# output.max_file_bytes (apps/api/contract/prediction_contract.json).
# EVAL_MAX_OUTPUT_BYTES=
