# LOCAL DEVELOPMENT ONLY. Generate new secrets before deployment.
POSTGRES_PASSWORD=local-challenge-only
SECRET_KEY=local-development-only-change-this-64-character-secret-before-deploy
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATA_HOST_DIR=../admin-2026-protein-data/data

# Submission limits. Confirmed: ZIP 500 MB, inference 10 minutes, 20 submissions per team.
MAX_ZIP_BYTES=524288000
INFERENCE_TIMEOUT_SECONDS=600
TEAM_SUBMISSION_LIMIT=20
# PROVISIONAL until organizers decide (Q2, Q3).
MAX_UNZIPPED_BYTES=2147483648
MAX_ZIP_ENTRIES=2000
ZIP_REQUIRED=inference.py,train.py,requirements.txt,model/

# Until this time (ISO 8601) only signed-in admins see the site; everyone else gets a
# D-day countdown that hides the topic. Unset means 2026-11-01 13:00 KST. A past time
# opens the site now. APPLY_URL is the sign-up Google Form behind the countdown's button.
# LAUNCH_AT=2026-11-01T13:00:00+09:00
# APPLY_URL=https://forms.gle/...

# Mock evaluator only: seconds a fake scoring run takes.
MOCK_DELAY_SECONDS=5

# Real scoring (docker-compose.evaluator.yml). Host paths on the scoring computer.
# The input directory holds only test.csv, test_features.csv, test_structures.zip (no labels).
# On Docker Desktop for Windows use an ASCII path such as C:/admin-eval/input.
# EVAL_WORK_HOST_DIR=/srv/admin-eval-work
# EVAL_INPUT_HOST_DIR=/srv/admin-eval-input
# EVAL_COMMAND=python inference.py --input /input/test_features.csv --output /output/predictions.csv
# EVAL_IMAGE=admin-evaluator:latest
# EVAL_CPUS=4
# EVAL_MEMORY=8g
# Seconds to install a submission's requirements.txt packages, not counted in inference.
# EVAL_INSTALL_TIMEOUT_SECONDS=600
# Volume caching packages downloaded from PyPI between submissions. Empty: no cache.
# EVAL_PIP_CACHE_VOLUME=admin-eval-pip-cache

# ngrok (docker-compose.ngrok.yml). Token: https://dashboard.ngrok.com/get-started/your-authtoken
# Domain: the address like name.ngrok-free.dev from https://dashboard.ngrok.com/domains,
# without https://. Not the ID that starts with rd_.
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
